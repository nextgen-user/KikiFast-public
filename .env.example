# KikiFast environment variables — copy to .env and fill in real values.
# .env is gitignored; never commit real secrets.

# --- Optional deployment overrides ---
KIKIFAST_CONFIG=tools_and_config/config.json
KIKIFAST_RUNTIME_DIR=runtime
KIKIFAST_SERVER_MANAGER_URL=http://127.0.0.1:8079
KIKIFAST_LLM_BASE_URL=http://127.0.0.1:8080/v1
KIKIFAST_WHISPER_CLI=whisper-cli
KIKIFAST_WHISPER_MODEL=ggml-base.en.bin
# Optional WhatsApp integration checkout (not bundled in this repository).
KIKIFAST_WHATSAPP_ROOT=integrations/whatsapp-mcp

# --- Speech-to-text ---
DEEPGRAM_API_KEY=

# --- LLM / cloud fallback (Vertex/Gemini/Groq via litellm) ---
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_KEY_PAID=
GEMINI_KEY_LIST=          # comma-separated for key rotation
GROQ_API_KEY=
GROQ_API_KEY_LIST=        # comma-separated for key rotation
OPENAI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

# --- Vertex AI service-account authentication ---
# Store the JSON outside the repository and point to it with an absolute path.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# --- Web search (tools.py search_web) ---
EXA_API_KEY=

# --- TTS (only needed if tts.provider = "inworld") ---
INWORLD_API_KEY=

# --- Self-extend (Smithery CLI / MCP) ---
SMITHERY_API_KEY=
GITHUB_TOKEN=
