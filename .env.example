# KikiFast environment variables — copy to .env and fill in real values.
# .env is gitignored; never commit real secrets. (The live .env is still tracked in
# history — run `git rm --cached .env` and ROTATE all keys below.)

# --- Speech-to-text ---
DEEPGRAM_API_KEY=

# --- LLM / cloud fallback (Vertex/Gemini/Groq via litellm) ---
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_KEY_PAID=
GEMINI_KEY_LIST=          # comma-separated for key rotation
GROQ_API_KEY=
GROQ_API_KEY_LIST=        # comma-separated for key rotation
OPENAI_API_KEY=

# --- Web search (tools.py search_web) ---
EXA_API_KEY=

# --- TTS (only needed if tts.provider = "inworld") ---
INWORLD_API_KEY=

# --- Self-extend (Smithery CLI / MCP) ---
SMITHERY_API_KEY=
GITHUB_TOKEN=
